# ============================================================================
# Hestia site configuration — copy to `hestia.env` and fill in your values.
#
#   cp config/hestia.env.example config/hestia.env
#   $EDITOR config/hestia.env
#
# The install scripts and the runtime shell scripts source this file. Values are
# plain `KEY=value` (no spaces around `=`; quote values with spaces).
#
# NOTHING SECRET GOES HERE. The Telegram bot token is a secret and lives ONLY in
# the broker's 0600 EnvironmentFile (see docs/configuration.md), never in this
# file and never committed. `hestia.env` itself is .gitignore'd anyway.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) OWNER IDENTITY (Telegram)  — REQUIRED
# ---------------------------------------------------------------------------
# Your numeric Telegram user id (NOT a username). Get it by messaging @userinfobot.
# The broker honors approval taps ONLY from this id. 0 = fail-closed (matches nobody).
HESTIA_OWNER_ID=0

# ---------------------------------------------------------------------------
# 2) THE TARGET MACHINE (the laptop/host the agent acts on, over Tailscale SSH) — REQUIRED
# ---------------------------------------------------------------------------
# The restricted unix user the broker runs commands as, @ the target's Tailscale
# host (MagicDNS name or 100.x tailnet IP). Created by install/target/1-users.sh.
HESTIA_TARGET_HOST=hestia-agent@your-laptop.your-tailnet.ts.net

# The OWNER's own unix account on the target machine. ELEVATED (owner-approved)
# commands run AS this user, reaching your private files. Must be a real account
# on the target. Rendered into the elevated wrapper's allowlist at install.
# REQUIRED only if you want the elevation feature.
OWNER_UNIX_USER=

# Optional: your tailnet IPs, used ONLY by the firewall backstop self-test to
# prove the box cannot reach them. Leave blank to skip those probes.
HOMESERVER_TAILSCALE_IP=
TARGET_TAILSCALE_IP=

# ---------------------------------------------------------------------------
# 3) THE CONFINED-AGENT CONTAINER (Phase 1)
# ---------------------------------------------------------------------------
CONTAINER_NAME=hestia-box          # LXD container that runs your agent
AGENT_BOX_USER=hestia              # the agent's unix user inside the container
HESTIA_BRIDGE=lxdbr0               # the LXD bridge the container is on

# Optional bridge-addressing overrides. The egress firewall AUTO-DETECTS these
# from the live bridge; set them only if detection fails.
# CONTAINER_SUBNET_V4=10.x.y.0/24
# LXDBR_GW4=10.x.y.1
# CONTAINER_SUBNET_V6=fd42:...::/64
# LXDBR_GW6=fd42:...::1

# ---------------------------------------------------------------------------
# 4) THE AGENT'S MODEL PROVIDER (Phase 1 — used to render the agent config)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint. An open-weight model is recommended for a
# self-hosted personal agent. These are NOT secrets (the API key is an env var).
LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
LLM_API_KEY_ENV=OPENAI_API_KEY     # name of the env var holding the API key
MODEL_NAME=your-model-name

# ---------------------------------------------------------------------------
# 5) BROKER TUNING (optional — sensible defaults baked in)
# ---------------------------------------------------------------------------
# HESTIA_SESSION_SECS=600          # open-window duration (per owner-approved session)
# HESTIA_CMD_SECS=180              # per-command approval timeout (auto-deny after)
# HESTIA_SESSION_ASK_SECS=300      # session-open button timeout
# HESTIA_EXEC_TIMEOUT=120          # max seconds a single relayed command may run
# HESTIA_MAX_INFLIGHT=6            # concurrent relayed commands cap
# HESTIA_MAX_PENDING=20            # outstanding approval buttons cap
# HESTIA_SESSION_CMD_BUDGET=40     # commands allowed per open window

# ---------------------------------------------------------------------------
# 6) THE LLM REVIEWER (optional — fail-closed; OFF by default)
# ---------------------------------------------------------------------------
# A second, independent LLM that judges whether a middle-tier command fits your
# stated session intent — so in-intent commands auto-run (confined) with no tap, and
# off-intent ones still escalate to a button. It can ONLY tighten: it never lowers the
# deterministic policy-tier floor, and if it is unreachable/unconfigured EVERY middle
# command fails CLOSED to an owner button. A startup preflight probes it (+ confinement
# + elevation) and DMs you once if auto-mode is degraded. OFF unless you set =1.
HESTIA_REVIEWER_ENABLED=0
# Any OpenAI-compatible chat/completions endpoint (NOT a secret).
HESTIA_REVIEWER_BASE_URL=https://your-openai-compatible-endpoint.example/v1/chat/completions
HESTIA_REVIEWER_MODEL=your-reviewer-model-name
# HESTIA_REVIEWER_KEY  — SECRET. Do NOT put it here. Set it ONLY in the broker's
#   0600 EnvironmentFile (see docs/configuration.md), exactly like the bot token.
# HESTIA_REVIEWER_TIMEOUT=8            # per-call HTTP timeout (seconds)
# HESTIA_REVIEWER_MAXTOK=64            # max_tokens for the verdict
# HESTIA_REVIEWER_RETRIES=1            # retry a transport blip before failing closed
# HESTIA_REVIEWER_RETRY_BACKOFF=0.3    # linear backoff between retries (seconds)
# HESTIA_MAX_REVIEWS=4                 # concurrent in-flight reviews (excess -> button)
# HESTIA_REVIEWER_BREAKER_N=4          # consecutive failures before the breaker opens
# HESTIA_REVIEWER_BREAKER_COOLDOWN=30  # seconds before a half-open recovery trial
# Tier-adaptive thinking (default OFF = reasoning "none"). The destructive SOFT_DENY
# tier MAY opt into a bigger reasoning budget; unset keeps it == base (a no-op).
# HESTIA_REVIEWER_EFFORT=none
# HESTIA_REVIEWER_SOFT_EFFORT=none
# HESTIA_REVIEWER_SOFT_MAXTOK=64
# HESTIA_REVIEWER_SOFT_TIMEOUT=8

# ---------------------------------------------------------------------------
# 7) RUNTIME CONFINEMENT + EXFIL CAP (optional — sensible defaults)
# ---------------------------------------------------------------------------
# Auto-run (FREE_ZONE + reviewer-ALLOW) commands execute inside a bubblewrap jail
# with the network unshared (anti-exfil). If bwrap/userns is unavailable the broker
# fails CLOSED (auto-run disabled -> every command asks); the preflight warns you.
# HESTIA_CONFINE_USERNS=1              # 1/0 pins the userns probe; unset = live-probe
# HESTIA_BWRAP=bwrap                   # bubblewrap binary
# HESTIA_EXFIL_CAP_N=40                # max DISTINCT auto-approved commands per window
#                                      #   (<=0 disables; default = HESTIA_SESSION_CMD_BUDGET)

# ---------------------------------------------------------------------------
# 8) FIXED DESIGN CONSTANTS (change only if you know why)
# ---------------------------------------------------------------------------
# The FREE_ZONE-tier workspace on the target — the ONLY place FREE_ZONE (un-buttoned,
# confined) commands may read. Must match on the broker and the target executor.
WORKSPACE=/srv/projects

# ---------------------------------------------------------------------------
# 9) BOX-SIDE RELAY CLIENT (hestia-relay, runs inside the container)
# ---------------------------------------------------------------------------
# The calling agent's terminal tool kills any command after a fixed deadline
# (120s in the reference agent). session-open and tap-requiring commands can
# take minutes of human latency, so the client NEVER blocks that long: it polls
# for HESTIA_OPEN_WAIT seconds, returns exit 3 (PENDING), and the agent polls
# `session-status` / `command-status`. Keep this comfortably under the kill
# deadline; the client clamps it to 100.
# HESTIA_OPEN_WAIT=90
#
# Where the client caches the pending request + the broker's decision. MUST be
# writable — if this write fails the owner's approval is consumed and lost.
# HESTIA_RELAY_STATE=~/.hestia-relay-state
#
# Default working directory ON THE TARGET for relayed commands. Set this to the
# OWNER's home (see OWNER_UNIX_USER). Do NOT point it at a retired/empty staging
# directory: a bare `ls`/`find` would then succeed with no output, which reads as
# success and invites the agent to fabricate results.
# HESTIA_DEFAULT_CWD=/home/<OWNER_UNIX_USER>

# ---------------------------------------------------------------------------
# 10) MEMORY LAYERS 2 AND 3
# ---------------------------------------------------------------------------
# Hindsight server home (own virtualenv — see memory/README.md for why).
# HESTIA_MEMORY_HOME=/home/<AGENT_BOX_USER>/hindsight-server
#
# Vault roots. Plain markdown folders; sync them to the owner's devices however
# you like. The owner vault is the one they read on their phone.
# HESTIA_VAULT_OWNER=/home/<AGENT_BOX_USER>/journal
# HESTIA_VAULT_RUNBOOK=/home/<AGENT_BOX_USER>/notes
#
# The bundled `obsidian` skill resolves the vault path from this:
# OBSIDIAN_VAULT_PATH=/home/<AGENT_BOX_USER>/notes
